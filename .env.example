# Environment Configuration — Domain Attack Surface Scanner
# Copy to .env for local development or set in your production container environment.

# ─── Server Core (Required) ───────────────────────────────────────────
# Port for the Node/Express backend process
PORT=3001
# Runtime environment: 'development', 'test', or 'production'
NODE_ENV=development

# ─── CORS & Domain Boundary (Required) ─────────────────────────────────
# Absolute URL of the frontend application. In production with reverse proxy,
# this should match the canonical public origin (e.g., https://scanner.example.com)
CLIENT_ORIGIN=http://localhost:5173

# ─── Scan Creation Rate Limiting (Optional) ───────────────────────────
# Protects against abusive automated scan submissions.
# Defaults:
#   Development/test: 100 scans per 15 minutes (SCAN_RATE_LIMIT_MAX=100, SCAN_RATE_LIMIT_WINDOW_MS=900000)
#   Production: 10 scans per 1 hour (SCAN_RATE_LIMIT_MAX=10, SCAN_RATE_LIMIT_WINDOW_MS=3600000)
# SCAN_RATE_LIMIT_MAX=10
# SCAN_RATE_LIMIT_WINDOW_MS=3600000

# ─── Outbound Resource & Concurrency Safeguards (Optional) ─────────────
# Maximum overall scan runtime before aborting (default: 120000 ms / 2 mins)
# SCAN_TIMEOUT_MS=120000
# Maximum concurrent scan jobs handled simultaneously (default: 2)
# MAX_CONCURRENT_SCANS=2
# Maximum subdomains parsed from CT logs (default: 200)
# MAX_SUBDOMAINS=200
# Maximum normalized assets stored per scan (default: 500)
# MAX_ASSETS=500
# Maximum bytes read for any single external HTTP response (default: 524288 / 512KB)
# MAX_RESPONSE_BYTES=524288
# Maximum HTTP redirects followed per endpoint probe (default: 3)
# MAX_REDIRECTS=3
# Maximum total external HTTP/TLS requests allowed per scan budget (default: 30)
# MAX_EXTERNAL_REQUESTS=30

# ─── Authentication & Session Security (Required in Production) ─────────
# Cryptographic secret for signing session tokens (must be >= 32 chars in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=c8e9b4f2167d4a10e82c5f1a9b3e7d6c5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d

# ─── Database & Persistence (Optional / Recommended in Production) ──────
# PostgreSQL connection URI. If omitted, falls back to atomic local JSON store (.data/dass_db.json)
# DATABASE_URL=postgres://dass_user:STRONG_PASSWORD@db.example.com:5432/dass_production?sslmode=require
# Set to 'true' to ensure production fails immediately if DATABASE_URL is missing
# REQUIRE_POSTGRES=false

# ─── Reverse Proxy & Trust Configuration ────────────────────────────────
# Configure if deployed behind Nginx, Caddy, Cloudflare, or AWS ALB
# Values: '1' (single hop), 'true', or subnet CIDR. Set to 'false' if directly exposed.
# TRUST_PROXY=1

# ─── Hourly Scanning Quotas ─────────────────────────────────────────────
# Maximum scans per hour for unauthenticated visitors (identified by real IP)
# ANONYMOUS_SCAN_LIMIT=5
# Maximum scans per hour for registered user accounts (identified by user ID)
# REGISTERED_SCAN_LIMIT=50
# Quota sliding window in milliseconds (default: 3600000 / 1 hour)
# SCAN_LIMIT_WINDOW_MS=3600000

# ─── Approximate IP Infrastructure Intelligence (Optional) ─────────────
# Enables datacenter & ASN enrichment via public IP intelligence APIs
# IP_INTELLIGENCE_ENABLED=true
# Must be an HTTPS endpoint containing the {ip} template parameter
# IP_INTELLIGENCE_URL=https://ipapi.co/{ip}/json/
# Timeout for IP provider queries in milliseconds (default: 5000 ms)
# IP_INTELLIGENCE_TIMEOUT_MS=5000
# Comma-separated list of additional permitted provider hostnames
# ALLOWED_IP_INTELLIGENCE_HOSTS=ipapi.co,ip-api.com,ipwhois.app,ipinfo.io
