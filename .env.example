# Environment variables for Domain Attack Surface Scanner

# ─── Server ───────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────
# Frontend origin (Vite dev default)
CLIENT_ORIGIN=http://localhost:5173

# ─── Scan rate limiting ──────────────────────────────
# Development/test defaults: 100 scans per 15 minutes.
# Production defaults: 10 scans per hour.
# Set these explicitly to override the environment-specific defaults.
# SCAN_RATE_LIMIT_MAX=100
# SCAN_RATE_LIMIT_WINDOW_MS=900000

# ─── Scanner resource controls ───────────────────────
# All values are configurable safeguards for public deployments.
# SCAN_TIMEOUT_MS=120000
# MAX_CONCURRENT_SCANS=2
# MAX_SUBDOMAINS=200
# MAX_ASSETS=500
# MAX_RESPONSE_BYTES=524288
# MAX_REDIRECTS=3
# MAX_EXTERNAL_REQUESTS=30

# ─── Approximate IP infrastructure intelligence ──────
# Provider data describes network/infrastructure location, not a person.
# IP_INTELLIGENCE_ENABLED=true
# IP_INTELLIGENCE_URL=https://ipapi.co/{ip}/json/
# IP_INTELLIGENCE_TIMEOUT_MS=5000
