# Environment variables for Domain Attack Surface Scanner

# ─── Server ───────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────
# Frontend origin (Vite dev default)
CLIENT_ORIGIN=http://localhost:5173

# ─── Scan rate limiting ──────────────────────────────
# Development/test defaults: 100 scans per 15 minutes.
# Production defaults: 10 scans per hour.
# Set these explicitly to override the environment-specific defaults.
# SCAN_RATE_LIMIT_MAX=100
# SCAN_RATE_LIMIT_WINDOW_MS=900000
