# Environment Variables for ReconLab

# ─── Server ───────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Admin Credentials ────────────────────────────────
# Change these before any deployment. Production refuses known placeholders.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# ─── CORS ─────────────────────────────────────────────
# Frontend origin (Vite dev default)
CLIENT_ORIGIN=http://localhost:5173

# ─── Upload limits ────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ─── Session defaults ─────────────────────────────────
# In development, short durations are available (1m, 5m, 10m)
# In production only 1h/6h/12h/24h are exposed in the UI
ENABLE_SHORT_DURATIONS=true

# ─── Storage ──────────────────────────────────────────
# Local filesystem path for temp uploads
UPLOAD_DIR=./uploads

# ─── Cleanup ──────────────────────────────────────────
# How often (ms) the cleanup job runs
CLEANUP_INTERVAL_MS=60000

# ─── IP Geolocation ───────────────────────────────────
# Set to false to disable geo lookups entirely
GEO_ENABLED=true
# Provider URL — {ip} is replaced with the visitor IP
# Default: ipapi.co (free, no key required for basic use)
GEO_PROVIDER_URL=https://ipapi.co/{ip}/json/
# Optional API key if your provider requires one
GEO_API_KEY=
# Timeout in ms for geo lookups (default 3000)
GEO_TIMEOUT_MS=3000
